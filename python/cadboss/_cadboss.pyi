import os
from typing import Final

__version__: Final[str]

class CadError(Exception): ...

class Layer:
    @property
    def name(self) -> str | bytes: ...
    @property
    def color(self) -> int: ...
    @property
    def frozen(self) -> bool: ...
    @property
    def off(self) -> bool: ...
    @property
    def locked(self) -> bool: ...

class Layout:
    @property
    def name(self) -> str | bytes: ...
    @property
    def kind(self) -> str: ...
    @property
    def entity_count(self) -> int: ...

class TextItem:
    @property
    def text(self) -> str | bytes: ...
    @property
    def source(self) -> str: ...
    @property
    def layer(self) -> str | bytes: ...
    @property
    def layout(self) -> str | bytes: ...
    @property
    def position(self) -> tuple[float, float, float] | None: ...
    @property
    def height(self) -> float | None: ...

class Skipped:
    @property
    def kind(self) -> str: ...
    @property
    def reason(self) -> str: ...
    @property
    def count(self) -> int: ...

class Document:
    @staticmethod
    def open(
        path: str | os.PathLike[str], *, budget: dict[str, int] | None = None
    ) -> Document: ...
    @staticmethod
    def load(
        data: bytes | bytearray | memoryview, *, budget: dict[str, int] | None = None
    ) -> Document: ...
    @property
    def format(self) -> str: ...
    @property
    def version(self) -> str | bytes: ...
    @property
    def units(self) -> str: ...
    @property
    def layers(self) -> list[Layer]: ...
    @property
    def layouts(self) -> list[Layout]: ...
    @property
    def blocks(self) -> list[str | bytes]: ...
    @property
    def entity_counts(self) -> list[tuple[str, int]]: ...
    @property
    def extents(
        self,
    ) -> tuple[tuple[float, float, float], tuple[float, float, float]] | None: ...
    def text(self, group: str = "all", layout: str | None = None) -> list[TextItem]: ...
    def markdown(self, title: str | None = None) -> str: ...
    def json(self, compact: bool = False) -> str: ...
    def report(self) -> list[Skipped]: ...
